<UserControl
  x:Class="PdfExtractionLab.App.BenchmarkView"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
  <DockPanel>
    <WrapPanel DockPanel.Dock="Top" Margin="0,4">
      <TextBlock VerticalAlignment="Center" Text="繰り返し " />
      <TextBox Width="65" Text="{Binding Repeats,UpdateSourceTrigger=PropertyChanged}" />
      <ComboBox ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" />
      <ComboBox ItemsSource="{Binding Lifetimes}" SelectedItem="{Binding Life}" />
      <TextBlock VerticalAlignment="Center" Text="　ワーカー " />
      <ComboBox ItemsSource="{Binding WorkerOptions}" SelectedItem="{Binding Workers}" />
      <CheckBox
        Margin="8,0"
        VerticalAlignment="Center"
        IsChecked="{Binding Warmup}"
        Content="各処理を1回ウォームアップ"
      />
      <Button Command="{Binding BenchmarkCommand}" Content="測定開始" />
    </WrapPanel>
    <TextBlock
      DockPanel.Dock="Top"
      TextWrapping="Wrap"
      Margin="2,5"
      Text="平均・中央値・最小・最大・P95・標本標準偏差の単位は ms。Open は毎回新規。個別抽出は開く時間を除外。Total は Reopen のとき開く時間を含みます。"
    />
    <TextBlock DockPanel.Dock="Top" Margin="2,5" Text="{Binding BenchSummary}" />
    <DataGrid ItemsSource="{Binding Rows}" />
  </DockPanel>
</UserControl>
